# ─── NexusAgent MCP Configuration ──────────────────────────────────────
# Copy this file to .env and configure your credentials
# Author: Anurag Gurjar (https://github.com/anuraggurjar01)

# OpenAI API Key (Required for GPT models)
OPENAI_API_KEY=sk-your-openai-api-key-here

# LLM Model Configuration (Default: gpt-4o-mini)
# Options: gpt-4o-mini, gpt-4o, gpt-4-turbo, o1-mini
LLM_MODEL=gpt-4o-mini

# Model Temperature (0.0 to 1.0)
LLM_TEMPERATURE=0.7

# Optional: LangSmith Tracing for Agent Observability
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_pt_...
# LANGCHAIN_PROJECT=NexusAgent-MCP
